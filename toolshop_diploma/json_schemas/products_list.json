{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "current_page": { "type": ["integer", "null"] },
    "total": { "type": ["integer", "null"] },
    "per_page": { "type": ["integer", "null"] },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "price": { "type": ["number", "null"] },
          "in_stock": { "type": ["boolean", "null"] }
        },
        "required": ["id", "name"]
      }
    }
  },
  "required": ["data"]
}
