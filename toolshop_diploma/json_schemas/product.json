{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "price": { "type": ["number", "null"] },
    "in_stock": { "type": ["boolean", "null"] }
  },
  "required": ["id", "name"]
}
